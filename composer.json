{
	"name": "magepeople/magepeople-yacht-booking-system",
	"description": "Yacht and boat charter booking for WordPress.",
	"type": "wordpress-plugin",
	"license": "GPL-2.0-or-later",
	"require": {
		"php": ">=8.0"
	},
	"autoload": {
		"psr-4": {
			"Ybs\\": "includes/"
		},
		"files": [
			"includes/functions.php"
		]
	},
	"config": {
		"optimize-autoloader": true,
		"sort-packages": true
	}
}